{
  "name": "zenith",
  "private": true,
  "description": "Zenith: time tracking with intention. The web app, the Tauri pop-up, and the platform behind them.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zenith/web",
    "build": "npm run build -w @zenith/web",
    "lint": "npm run lint -w @zenith/web",
    "dev:popup": "npm run dev -w @zenith/popup",
    "tauri:popup": "npm run tauri -w @zenith/popup --",
    "test": "npm run test --workspaces --if-present"
  }
}
