{
  "name": "zenith-sync-bench",
  "private": true,
  "type": "module",
  "description": "Benchmarks for choosing the sync merge library (S03). Not part of the app build.",
  "scripts": {
    "generate": "node generate.mjs",
    "test": "node --test --test-isolation=none model.test.mjs",
    "bench:automerge": "node --expose-gc bench.mjs automerge",
    "bench:yjs": "node --expose-gc bench.mjs yjs",
    "bench:report": "node bench.mjs",
    "bench:sharded:automerge": "node --expose-gc sharded.mjs automerge",
    "bench:sharded:yjs": "node --expose-gc sharded.mjs yjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "yjs": "^13.6.33"
  }
}
